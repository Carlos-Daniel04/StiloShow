generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  CLIENTE
  EMPLEADO
  ADMINISTRADOR
}

enum EstadoCita {
  CONFIRMADA
  COMPLETADA
  CANCELADA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Usuario {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique @db.VarChar(320)
  passwordHash    String          @db.VarChar(255)
  nombre          String          @db.VarChar(80)
  apellido        String          @db.VarChar(80)
  telefono        String?         @db.VarChar(30)
  rol             RolUsuario      @default(CLIENTE)
  activo          Boolean         @default(true)
  perfilEmpleado  PerfilEmpleado?
  citasCliente    Cita[]          @relation("CitasCliente")
  creadoEn        DateTime        @default(now())
  actualizadoEn   DateTime        @updatedAt

  @@index([rol, activo])
  @@index([activo])
  @@map("usuarios")
}

model PerfilEmpleado {
  id              String            @id @default(uuid()) @db.Uuid
  usuarioId       String            @unique @db.Uuid
  especialidad    String            @db.VarChar(160)
  usuario         Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  horarios        HorarioLaboral[]
  citasAsignadas  Cita[]            @relation("CitasEmpleado")
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt

  @@index([especialidad])
  @@map("perfiles_empleado")
}

model Servicio {
  id              String       @id @default(uuid()) @db.Uuid
  nombre          String       @unique @db.VarChar(120)
  descripcion     String       @db.Text
  precio          Decimal      @db.Decimal(10, 2)
  duracionMinutos Int
  activo          Boolean      @default(true)
  citas           Cita[]
  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt

  @@index([activo])
  @@map("servicios")
}

model HorarioLaboral {
  id          String         @id @default(uuid()) @db.Uuid
  empleadoId  String         @db.Uuid
  diaSemana   DiaSemana
  horaInicio  DateTime       @db.Time(0)
  horaCierre  DateTime       @db.Time(0)
  activo      Boolean        @default(true)
  empleado    PerfilEmpleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  creadoEn    DateTime       @default(now())
  actualizadoEn DateTime     @updatedAt

  @@unique([empleadoId, diaSemana, horaInicio, horaCierre])
  @@index([empleadoId, diaSemana, activo])
  @@map("horarios_laborales")
}

model Cita {
  id          String        @id @default(uuid()) @db.Uuid
  clienteId   String        @db.Uuid
  empleadoId  String        @db.Uuid
  servicioId  String        @db.Uuid
  iniciaEn    DateTime
  terminaEn   DateTime
  estado      EstadoCita    @default(CONFIRMADA)
  cliente     Usuario       @relation("CitasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  empleado    PerfilEmpleado @relation("CitasEmpleado", fields: [empleadoId], references: [id], onDelete: Restrict)
  servicio    Servicio      @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  creadoEn    DateTime      @default(now())
  actualizadoEn DateTime    @updatedAt

  @@index([clienteId, iniciaEn])
  @@index([empleadoId, iniciaEn])
  @@index([servicioId, iniciaEn])
  @@index([estado, iniciaEn])
  @@map("citas")
}
